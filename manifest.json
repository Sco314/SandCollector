{
  "manifest_version": 3,
  "name": "WhyDOM",
  "version": "0.2.5",
  "description": "Free CSS inspector and front-end debugger. Click an element, copy useful CSS, and understand what controls it.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "WhyDOM: Inspect this page"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  }
}
